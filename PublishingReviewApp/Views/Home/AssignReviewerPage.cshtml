@{
    ViewData["Title"] = "Назначение рецензента";
}

<h2>Назначение рецензента</h2>
<form id="assignForm" class="w-50">
    <div class="mb-3"><label class="form-label">ID задачи</label><input name="taskId" type="number" class="form-control" required /></div>
    <div class="mb-3"><label class="form-label">Email рецензента</label><input name="reviewerEmail" type="email" class="form-control" required /></div>
    <div class="mb-3"><label class="form-label">Дедлайн</label><input name="deadlineUtc" type="date" class="form-control" /></div>
    <button class="btn btn-secondary">Назначить</button>
</form>