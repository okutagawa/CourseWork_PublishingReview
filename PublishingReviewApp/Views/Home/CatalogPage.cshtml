@{
    ViewData["Title"] = "Каталог изданий";
    var isEmployee = (ViewBag.IsEmployee as bool?) == true;
}

<h2>Каталог изданий с рецензиями</h2>
<div class="row g-2 mb-3">
    <div class="col-md-4"><input id="searchText" class="form-control" placeholder="Поиск по названию или автору" /></div>
    <div class="col-md-3"><input id="typeFilter" class="form-control" placeholder="Тип издания" /></div>
    <div class="col-md-5 d-flex gap-2">
        <button class="btn btn-secondary" onclick="loadCatalog()">Найти</button>
    </div>
</div>

@if (isEmployee)
{
    <div class="card p-3 mb-3">
        <h5>CRUD изданий (сотрудник)</h5>
        <div class="row g-2">
            <div class="col-md-2"><input id="pubId" type="number" class="form-control" placeholder="ID для обновления" /></div>
            <div class="col-md-3"><input id="pubTitle" class="form-control" placeholder="Название" /></div>
            <div class="col-md-2"><input id="pubAuthor" class="form-control" placeholder="Автор" /></div>
            <div class="col-md-2"><input id="pubType" class="form-control" placeholder="Тип" /></div>
            <div class="col-md-3"><input id="pubSummary" class="form-control" placeholder="Итог рецензии (авто)" readonly /></div>
        </div>
        <div class="mt-2 d-flex gap-2">
            <button class="btn btn-success" onclick="createPublication()">Создать</button>
            <button class="btn btn-primary" onclick="updatePublication()">Обновить</button>
            <button class="btn btn-danger" onclick="deletePublication()">Удалить</button>
        </div>
    </div>
}

<table class="table table-striped">
    <thead><tr><th>ID</th><th>Название</th><th>Автор</th><th>Тип</th><th>Итог</th><th>Рецензий</th><th>Действия</th></tr></thead>
    <tbody id="catalogBody"></tbody>
</table>

<div class="modal fade" id="publicationReviewsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="publicationReviewsTitle">Рецензии по изданию</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body" id="publicationReviewsBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const isEmployee = @isEmployee.ToString().ToLowerInvariant();

        function query() {
            const params = new URLSearchParams();
            const search = document.getElementById('searchText').value;
            const type = document.getElementById('typeFilter').value;
            if (search) params.append('search', search);
            if (type) params.append('publicationType', type);
            return params.toString();
        }

        async function loadCatalog() {
            const response = await fetch(`/Home/GetCatalog${query() ? `?${query()}` : ''}`);
            if (!response.ok) return alert('Ошибка загрузки каталога.');
            const data = await response.json();
            const body = document.getElementById('catalogBody');
            body.innerHTML = '';
            data.forEach(item => {
                const employeeHint = "<span class='text-muted'>CRUD через форму выше</span>";
                const favoriteButton = `<button class='btn btn-sm ${item.isFavorite ? 'btn-warning' : 'btn-outline-warning'}' onclick='toggleFavorite(${item.id})'>${item.isFavorite ? '★ В избранном' : '☆ В избранное'}</button>`;
                const actions = `${isEmployee ? employeeHint : favoriteButton} <button class='btn btn-sm btn-outline-primary' onclick='showPublicationReviews(${item.id}, "${item.title.replace(/"/g, '&quot;')}")'>Рецензии</button>`;
                body.innerHTML += `<tr><td>${item.id}</td><td>${item.title}</td><td>${item.authorFullName}</td><td>${item.publicationType}</td><td>${item.reviewSummary}</td><td>${item.reviewCount}</td><td>${actions}</td></tr>`;
            });
        }

        async function showPublicationReviews(publicationId, title) {
            const response = await fetch(`/Home/PublicationReviewList/${publicationId}`);
            if (!response.ok) return alert(await response.text());
            const reviews = await response.json();
            document.getElementById('publicationReviewsTitle').textContent = `Рецензии: ${title}`;
            const body = document.getElementById('publicationReviewsBody');
            if (!reviews.length) {
                body.innerHTML = "<p class='text-muted mb-0'>Пока нет рецензий по этому изданию.</p>";
            } else {
                body.innerHTML = reviews.map(item => {
                    const comments = item.comments.length
                        ? item.comments.map(comment => `<li><b>${comment.authorName}</b>: ${comment.text}</li>`).join('')
                        : "<li class='text-muted'>Комментариев пока нет</li>";
                    return `<div class="card p-3 mb-3">
                        <div class="d-flex justify-content-between">
                            <h6 class="mb-1">Рецензия #${item.id}</h6>
                            <small>${new Date(item.createdUtc).toLocaleString()}</small>
                        </div>
                        <div><b>Автор рецензии:</b> ${item.userEmail}</div>
                        <p class="mt-2 mb-2">${item.reviewText}</p>
                        <div><b>Файл:</b> ${item.attachmentUrl ? `<a href="${item.attachmentUrl}" target="_blank">${item.attachmentFileName ?? 'Открыть'}</a>` : "—"}</div>
                        <div class="mt-2">
                            <b>Комментарии:</b>
                            <ul>${comments}</ul>
                            <div class='d-flex gap-2'>
                                <input id='catalog-comment-${item.id}' class='form-control form-control-sm' placeholder='Комментарий к рецензии' />
                                <button class='btn btn-sm btn-outline-secondary' onclick='addCatalogComment(${item.id})'>Отправить</button>
                            </div>
                        </div>
                    </div>`;
                }).join('');
            }

            const modal = new bootstrap.Modal(document.getElementById('publicationReviewsModal'));
            modal.show();
        }

        async function addCatalogComment(reviewId) {
            const input = document.getElementById(`catalog-comment-${reviewId}`);
            if (!input?.value) return;
            const response = await fetch('/Home/AddComment', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reviewId, text: input.value })
            });
            if (!response.ok) return alert(await response.text());
            input.value = '';
            loadCatalog();
        }

        async function toggleFavorite(publicationId) {
            const response = await fetch('/Home/ToggleFavorite', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ publicationId })
            });
            if (!response.ok) return alert('Не удалось обновить избранное.');
            loadCatalog();
        }

        async function createPublication() {
            const payload = {
                title: document.getElementById('pubTitle').value,
                authorFullName: document.getElementById('pubAuthor').value,
                publicationType: document.getElementById('pubType').value,
            };
            const response = await fetch('/Home/CreatePublication', {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
            });
            if (!response.ok) return alert(await response.text());
            loadCatalog();
        }

        async function updatePublication() {
            const payload = {
                id: Number(document.getElementById('pubId').value),
                title: document.getElementById('pubTitle').value,
                authorFullName: document.getElementById('pubAuthor').value,
                publicationType: document.getElementById('pubType').value,
                reviewSummary: document.getElementById('pubSummary').value
            };
            const response = await fetch('/Home/UpdatePublication', {
                method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
            });
            if (!response.ok) return alert(await response.text());
            loadCatalog();
        }

        async function deletePublication() {
            const id = Number(document.getElementById('pubId').value);
            if (!id) return alert('Укажите ID для удаления');
            const response = await fetch(`/Home/DeletePublication/${id}`, { method: 'DELETE' });
            if (!response.ok) return alert(await response.text());
            loadCatalog();
        }

        document.addEventListener('DOMContentLoaded', loadCatalog);
    </script>
}
