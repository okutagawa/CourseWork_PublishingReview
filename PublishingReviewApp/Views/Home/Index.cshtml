@model PublishingReviewApp.Models.PublicationListViewModel
@{
    ViewData["Title"] = "Главная";
}

<div class="text-center mb-4">
    <h1 class="display-5">Проектирование и разработка модуля рецензирования для издательства</h1>
    <p class="lead">Учебный веб-модуль для управления рукописями, назначением рецензентов и фиксацией решений по публикациям.</p>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">1. Приём рукописей</h5>
                <p class="card-text">Редактор вносит новую публикацию и отправляет её в очередь рецензирования.</p>
                <a asp-controller="Home" asp-action="CreatePublicationPage" class="btn btn-secondary">Создать карточку</a>
                </div>
            </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">2. Назначение экспертов</h5>
                <p class="card-text">Назначение рецензента, установка дедлайна и контроль загрузки редакции.</p>
                <a asp-controller="Home" asp-action="ReviewQueuePage" class="btn btn-secondary">Открыть очередь</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">3. Итоговое решение</h5>
                <p class="card-text">Фиксация статуса: одобрено, на доработку или отклонено, плюс отчётность.</p>
                <a asp-controller="Home" asp-action="ReportPage" class="btn btn-secondary">Перейти к отчётам</a>
            </div>
        </div>
    </div>
</div>