@{
    ViewData["Title"] = "Очередь рецензий";
}

<h2>Очередь рецензирования</h2>
<div class="row g-3 mb-3">
    <div class="col-md-4">
        <label class="form-label">Статус</label>
        <select id="stateFilter" class="form-select">
            <option value="">Все</option>
            <option value="WaitingForReviewer">Ожидает рецензента</option>
            <option value="InReview">В рецензировании</option>
            <option value="RequiresRevision">Требует доработки</option>
            <option value="Approved">Одобрено</option>
            <option value="Rejected">Отклонено</option>
        </select>
    </div>
    <div class="col-md-8 d-flex align-items-end">
        <button class="btn btn-secondary" onclick="loadQueue()">Обновить</button>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-6">
        <div class="card p-3">
            <h5>Назначение рецензента</h5>
            <div class="form-text mb-2">Выберите рукопись из списка или укажите ее ID (PublicationId).</div>
            <div class="mb-2"><select id="assignPublicationSelect" class="form-select" onchange="syncAssignPublicationId()"><option value="">Выберите рукопись</option></select></div>
            <div class="row g-2">
                <div class="col-md-4"><input id="assignTaskId" type="number" class="form-control" placeholder="PublicationId (ID рукописи)" /></div>                <div class="col-md-5"><input id="assignReviewerEmail" type="email" class="form-control" placeholder="Email рецензента" /></div>
                <div class="col-md-3"><input id="assignDeadlineUtc" type="date" class="form-control" /></div>
            </div>
            <button class="btn btn-secondary mt-2" onclick="assignReviewer()">Назначить</button>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card p-3">
            <h5>Решение по рецензии</h5>
            <div class="form-text mb-2">Выберите задачу рецензии или укажите TaskId вручную (это не PublicationId).</div>
            <div class="mb-2"><select id="decisionTaskSelect" class="form-select" onchange="syncDecisionTaskId()"><option value="">Выберите задачу рецензии</option></select></div>
            <div class="row g-2">
                <div class="col-md-4"><input id="decisionTaskId" type="number" class="form-control" placeholder="TaskId (ID задачи рецензии)" /></div>                <div class="col-md-4">
                    <select id="decisionState" class="form-select">
                        <option value="Approved">Одобрить</option>
                        <option value="RequiresRevision">На доработку</option>
                        <option value="Rejected">Отклонить</option>
                    </select>
                </div>
                <div class="col-md-4"><input id="decisionComment" class="form-control" placeholder="Комментарий редактора" /></div>
            </div>
            <button class="btn btn-secondary mt-2" onclick="submitDecision()">Сохранить</button>
        </div>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Ключ</th>
            <th>ID задачи</th>
            <th>ID рукописи</th>
            <th>Рукопись</th>
            <th>Автор</th>
            <th>Тип</th>
            <th>Статус</th>
            <th>Рецензент</th>
            <th>Дедлайн</th>
        </tr>
    </thead>
    <tbody id="queueTable"></tbody>
</table>

@section Scripts {
    <script>
        async function loadQueue() {
            const state = document.getElementById('stateFilter').value;
            const url = state ? `/Home/ReviewQueueList?state=${state}` : '/Home/ReviewQueueList';
            const data = await fetch(url).then(r => r.json());
            const body = document.getElementById('queueTable');
            const assignSelect = document.getElementById('assignPublicationSelect');
            const decisionSelect = document.getElementById('decisionTaskSelect');
            const seenPublicationIds = new Set();
            body.innerHTML = '';
            assignSelect.innerHTML = '<option value="">Выберите рукопись</option>';
            decisionSelect.innerHTML = '<option value="">Выберите задачу рецензии</option>';
            data.forEach(item => {
                const key = `R-${item.taskId}/P-${item.publicationId}`;
                body.innerHTML += `<tr><td><code>${key}</code></td><td>${item.taskId}</td><td>${item.publicationId}</td><td>${item.title}</td><td>${item.authorFullName}</td><td>${item.publicationType}</td><td>${item.state}</td><td>${item.reviewerEmail ?? '—'}</td><td>${item.deadlineUtc ? new Date(item.deadlineUtc).toLocaleDateString() : '—'}</td></tr>`;
                if (!seenPublicationIds.has(item.publicationId)) {
                    assignSelect.innerHTML += `<option value="${item.publicationId}">P-${item.publicationId}: ${item.title}</option>`;
                    seenPublicationIds.add(item.publicationId);
                }
                decisionSelect.innerHTML += `<option value="${item.taskId}">R-${item.taskId}: ${item.title} (${item.state})</option>`;            
            });
        }

                function syncAssignPublicationId() {
            const publicationId = document.getElementById('assignPublicationSelect').value;
            if (publicationId) {
                document.getElementById('assignTaskId').value = publicationId;
            }
        }

        function syncDecisionTaskId() {
            const taskId = document.getElementById('decisionTaskSelect').value;
            if (taskId) {
                document.getElementById('decisionTaskId').value = taskId;
            }
        }

        async function assignReviewer() {
            const payload = {
                taskId: Number(document.getElementById('assignTaskId').value),
                reviewerEmail: document.getElementById('assignReviewerEmail').value,
                deadlineUtc: document.getElementById('assignDeadlineUtc').value || null
            };
            const response = await fetch('/Home/AssignReviewer', {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
            });
            if (!response.ok) return alert(await response.text());
            loadQueue();
        }

        async function submitDecision() {
            const payload = {
                taskId: Number(document.getElementById('decisionTaskId').value),
                decision: document.getElementById('decisionState').value,
                comment: document.getElementById('decisionComment').value
            };
            const response = await fetch('/Home/SubmitReviewResult', {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
            });
            if (!response.ok) return alert(await response.text());
            loadQueue();
        }
        document.addEventListener('DOMContentLoaded', loadQueue);
    </script>
}