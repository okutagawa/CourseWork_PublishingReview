@{
    ViewData["Title"] = "Профиль пользователя";
}

<h2>Профиль участника издательского процесса</h2>

<div class="card w-75 p-3">
    <p class="mb-2"><strong>ФИО:</strong> @ViewBag.UserFullName</p>
    <p class="mb-2"><strong>Email:</strong> @ViewBag.UserEmail</p>
    <p class="mb-0"><strong>Роль:</strong> @ViewBag.UserRole</p>
</div>