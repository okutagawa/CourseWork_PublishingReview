@{
    ViewData["Title"] = "Мои рецензии";
}

<h2>Мои рецензии</h2>

<div class="card p-3 mb-3">
    <div class="row g-2">
        <div class="col-md-2"><input id="reviewId" type="number" class="form-control" placeholder="ID (для ред.)" /></div>
        <div class="col-md-4">
            <select id="publicationId" class="form-select">
                <option value="">Выберите издание из каталога</option>
            </select>
        </div>
        <div class="col-md-3"><input id="attachmentFile" type="file" class="form-control" /></div>
        <div class="col-md-3"><button class="btn btn-success w-100" onclick="createReview()">Создать</button></div>
    </div>
    <div class="mt-2"><textarea id="reviewText" class="form-control" rows="3" placeholder="Текст рецензии"></textarea></div>
    <div class="mt-2 d-flex gap-2">
        <button class="btn btn-primary" onclick="updateReview()">Обновить</button>
        <button class="btn btn-danger" onclick="deleteReview()">Удалить</button>
    </div>
</div>

<table class="table table-striped">
    <thead><tr><th>ID</th><th>Издание</th><th>Рецензия</th><th>Файл</th><th>Комментарии</th></tr></thead>
    <tbody id="reviewBody"></tbody>
</table>

@section Scripts {
    <script>

        async function loadPublicationOptions() {
            const response = await fetch('/Home/GetCatalog');
            if (!response.ok) return;
            const data = await response.json();
            const select = document.getElementById('publicationId');
            data.forEach(item => {
                select.innerHTML += `<option value="${item.id}">${item.title} (${item.authorFullName})</option>`;
            });
        }

        function getAttachmentName() {
            const input = document.getElementById('attachmentFile');
            return input.files.length ? input.files[0].name : null;
        }

        async function loadReviews() {
            const response = await fetch('/Home/UserReviewList');
            if (!response.ok) return alert('Не удалось загрузить список рецензий.');
            const data = await response.json();
            const body = document.getElementById('reviewBody');
            body.innerHTML = '';
            for (const item of data) {
                const comments = await fetch(`/Home/CommentList/${item.id}`).then(r => r.json());
                const commentHtml = comments.map(c => `<div><b>${c.authorName}</b>: ${c.text}</div>`).join('') || '<span class="text-muted">Нет</span>';
                body.innerHTML += `<tr>
                    <td>
                        ${item.id}
                        <div class='mt-1 d-flex gap-1'>
                            <button class='btn btn-sm btn-outline-primary' onclick='fillForEdit(${item.id}, ${item.publicationId}, ${JSON.stringify(item.reviewText)})'>Ред.</button>
                            <button class='btn btn-sm btn-outline-danger' onclick='deleteById(${item.id})'>Удалить</button>
                        </div>
                    </td>
                    <td>${item.publicationTitle}</td>
                    <td>${item.reviewText}</td>
                    <td>${item.attachmentUrl ? `<a href="/Home/ReadAttachment/${item.id}" target="_blank">${item.attachmentFileName ?? 'Открыть'}</a>` : '—'}</td>
                    <td>
                        ${commentHtml}
                        <div class='mt-2 d-flex gap-1'>
                            <input id='comment-${item.id}' class='form-control form-control-sm' placeholder='Комментарий' />
                            <button class='btn btn-sm btn-outline-secondary' onclick='addComment(${item.id})'>Добавить</button>
                        </div>
                    </td>
                </tr>`;
            }
        }

        async function createReview() {
            const payload = new FormData();
            payload.append('publicationId', String(Number(document.getElementById('publicationId').value)));
            payload.append('reviewText', document.getElementById('reviewText').value);
            const fileInput = document.getElementById('attachmentFile');
            if (fileInput.files.length) {
                payload.append('attachment', fileInput.files[0]);
            }
            const response = await fetch('/Home/CreateUserReview', {
                method: 'POST', body: payload
            });
            if (!response.ok) return alert(await response.text());
            clearForm();
            loadReviews();
        }

        async function updateReview() {
            const reviewId = Number(document.getElementById('reviewId').value);
            if (!reviewId) return alert('Выберите рецензию через кнопку "Ред." или укажите ID.');
            const payload = new FormData();
            payload.append('id', String(reviewId));
            payload.append('publicationId', String(Number(document.getElementById('publicationId').value)));
            payload.append('reviewText', document.getElementById('reviewText').value);
            const fileInput = document.getElementById('attachmentFile');
            if (fileInput.files.length) {
                payload.append('attachment', fileInput.files[0]);
            }
            const response = await fetch('/Home/UpdateUserReview', {
                method: 'PUT', body: payload
            });
            if (!response.ok) return alert(await response.text());
            clearForm();
            loadReviews();
        }

        async function deleteReview() {
            const id = Number(document.getElementById('reviewId').value);
            if (!id) return alert('Укажите ID рецензии для удаления.');
            const response = await fetch(`/Home/DeleteUserReview/${id}`, { method: 'DELETE' });
            if (!response.ok) return alert(await response.text());
            clearForm();
            loadReviews();
        }

        async function deleteById(id) {
            const response = await fetch(`/Home/DeleteUserReview/${id}`, { method: 'DELETE' });
            if (!response.ok) return alert(await response.text());
            if (Number(document.getElementById('reviewId').value) === id) {
                clearForm();
            }
            loadReviews();
        }

        function fillForEdit(id, publicationId, reviewText) {
            document.getElementById('reviewId').value = id;
            document.getElementById('publicationId').value = publicationId;
            document.getElementById('reviewText').value = reviewText;
            document.getElementById('attachmentFile').value = '';
        }

        function clearForm() {
            document.getElementById('reviewId').value = '';
            document.getElementById('publicationId').value = '';
            document.getElementById('reviewText').value = '';
            document.getElementById('attachmentFile').value = '';
        }

        async function addComment(reviewId) {
            const text = document.getElementById(`comment-${reviewId}`).value;
            if (!text) return;
            const response = await fetch('/Home/AddComment', {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ reviewId, text })
            });
            if (!response.ok) return alert(await response.text());
            loadReviews();
        }

        document.addEventListener('DOMContentLoaded', async () => {
            await loadPublicationOptions();
            await loadReviews();
        });
    </script>
}