@{
    ViewData["Title"] = "Регистрация";
}

<div class="text-center"><h2 class="display-6">Регистрация участника процесса рецензирования</h2></div>

@if (ViewBag.Error is not null)
{
    <div class="alert alert-danger w-75 mx-auto mt-3">@ViewBag.Error</div>
}

<form method="post" asp-controller="Home" asp-action="Register" class="w-75 mx-auto mt-4">
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">ФИО</label><input type="text" name="fullName" class="form-control" required /></div>
        <div class="col-md-6"><label class="form-label">Email</label><input type="email" name="email" class="form-control" required /></div>
        <div class="col-md-6"><label class="form-label">Пароль</label><input type="password" name="password" class="form-control" minlength="6" required /></div>
        <div class="col-md-6"><label class="form-label">Роль</label><select name="role" class="form-select" required><option value="user">Пользователь</option><option value="employee">Сотрудник</option></select></div>
        <div class="col-12"><label class="form-label">Организация / кафедра</label><input type="text" name="organization" class="form-control" /></div>
    </div>
    <button class="btn btn-secondary mt-3" type="submit">Зарегистрироваться</button>
</form>