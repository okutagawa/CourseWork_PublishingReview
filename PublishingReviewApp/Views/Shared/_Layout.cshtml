﻿@{
var isAuth = Context.Session.GetString("IsAuthenticated") == bool.TrueString;
var userName = Context.Session.GetString("UserFullName") ?? "Пользователь";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Модуль рецензирования издательства</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PublishingReviewApp.styles.css" asp-append-version="true" />
    <style>
        body {
            background-color: #f7f3ed;
            color: #3f3127;
        }

        .navbar {
            background-color: #b78e5f !important;
        }

        .navbar-brand, .nav-link {
            color: #fff8ef !important;
        }

        .btn-primary,
        .btn-secondary {
            background-color: #8a5c3b;
            border-color: #8a5c3b;
        }

        .btn-primary:hover,
        .btn-secondary:hover {
            background-color: #74482b;
            border-color: #74482b;
        }

        .card {
            border: 1px solid #d8bf9e;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg mb-3 shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Издательство: рецензирование</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Главная</a></li>

                        @if (isAuth)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="DashboardPage">Панель рецензирования</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="ReviewQueuePage">Очередь рецензий</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="CreatePublicationPage">Новая рукопись</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="AssignReviewerPage">Назначение рецензента</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="SubmitDecisionPage">Решение по рецензии</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="ReportPage">Отчёты</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Privacy">@userName</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Logout">Выход</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Enter">Вход</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Register">Регистрация</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Модуль рецензирования издательства
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>