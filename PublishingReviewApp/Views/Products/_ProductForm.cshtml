@model PublishingReviewApp.DTOs.ProductCreateDto
<form method="post"><div asp-validation-summary="All" class="text-danger"></div><input type="hidden" asp-for="Id"/><div><label asp-for="Name"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div><label asp-for="Description"></label><textarea asp-for="Description" class="form-control"></textarea></div><div><label asp-for="Price"></label><input asp-for="Price" class="form-control"/></div><div><label asp-for="ImageUrl"></label><input asp-for="ImageUrl" class="form-control"/></div><div>@foreach(var c in (List<PublishingReviewDatabaseImplements.Models.Shop.Category>)ViewBag.Categories){<label><input type="checkbox" name="CategoryIds" value="@c.Id" checked="@(Model.CategoryIds.Contains(c.Id))"/> @c.Name</label><br/>}</div><button class="btn btn-primary">Сохранить</button></form><partial name="_ValidationScriptsPartial"/>
