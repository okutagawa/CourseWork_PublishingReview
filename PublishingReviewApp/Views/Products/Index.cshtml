@model List<PublishingReviewApp.DTOs.ProductDto>
<h2>Товары</h2><a asp-action="Create" class="btn btn-primary">Создать</a>
<form method="get" class="row g-2 my-2"><input name="q" class="form-control col" placeholder="Поиск"/><select name="category" class="form-select col"><option value="">Категория</option>@foreach(var c in (List<PublishingReviewDatabaseImplements.Models.Shop.Category>)ViewBag.Categories){<option value="@c.Id">@c.Name</option>}</select><input type="number" step="0.01" name="minPrice" placeholder="Мин цена" class="form-control col"/><input type="number" step="0.01" name="maxPrice" placeholder="Макс цена" class="form-control col"/><input type="number" step="0.1" name="minRating" placeholder="Мин рейтинг" class="form-control col"/><button class="btn btn-secondary col-2">Фильтр</button></form>
<table class="table"><tr><th>Название</th><th>Цена</th><th>Категории</th><th>Рейтинг</th><th></th></tr>@foreach(var i in Model){<tr><td>@i.Name</td><td>@i.Price</td><td>@i.Categories</td><td>@i.AverageRating (@i.ReviewsCount)</td><td><a asp-action="Details" asp-route-id="@i.Id">Подробнее</a> | <a asp-action="Edit" asp-route-id="@i.Id">Ред.</a> | <a asp-action="Delete" asp-route-id="@i.Id">Удал.</a> | <a asp-controller="Reviews" asp-action="Create" asp-route-productId="@i.Id">Отзыв</a></td></tr>}</table>
