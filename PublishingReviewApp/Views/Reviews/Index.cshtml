@model List<PublishingReviewApp.DTOs.ReviewDto>
<h2>Отзывы</h2><form method="get" class="row g-2"><input name="q" placeholder="Поиск" class="form-control col"/><input name="rating" type="number" min="1" max="5" class="form-control col" placeholder="Оценка"/><input name="from" type="date" class="form-control col"/><button class="btn btn-secondary col-2">Фильтр</button></form><table class="table"><tr><th>Товар</th><th>Пользователь</th><th>Отзыв</th><th>Оценка</th><th>Дата</th><th></th></tr>@foreach(var i in Model){<tr><td>@i.ProductName</td><td>@i.UserName</td><td>@i.Text</td><td>@i.UserRating</td><td>@i.CreatedAt</td><td><a asp-action="Edit" asp-route-id="@i.Id">Ред.</a> <a asp-action="Delete" asp-route-id="@i.Id">Удал.</a></td></tr>}</table>
